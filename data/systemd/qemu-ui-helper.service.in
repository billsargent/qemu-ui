# qemu-ui privileged helper (docs/design/privileged-helper.md). Generated by
# `qemu-ui service install`; @PLACEHOLDERS@ are filled in for the install.
[Unit]
Description=qemu-ui privileged helper (host disks, taps)
Documentation=https://github.com/billsargent/qemu-ui
Before=qemu-ui.service

[Service]
Type=simple
# Root by design: it is the narrow, audited broker for privileged requests.
# Its state dir holds the socket the daemon connects to by default
# (/run/qemu-ui-helper/helper.sock), export sockets, tap records and the
# audit log; it is kept across helper restarts (not across reboots, when
# exports and taps are gone too).
ExecStart=@HELPER@ --state-dir /run/qemu-ui-helper --config @HELPER_CONFIG@
@ENVIRONMENT@
# Disk exports (qemu-storage-daemon) serve running VMs: keep them across a
# helper restart, like the daemon keeps its VMs.
KillMode=process
Restart=on-failure
RestartSec=2
# Peers are authenticated by uid; the directory must be traversable by the
# daemon's user.
RuntimeDirectory=qemu-ui-helper
RuntimeDirectoryMode=0755
RuntimeDirectoryPreserve=yes
ProtectHome=read-only
PrivateTmp=yes

[Install]
WantedBy=multi-user.target
