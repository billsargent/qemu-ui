# qemu-ui daemon. Generated by `qemu-ui service install`; @PLACEHOLDERS@ are
# filled in for the current install.
[Unit]
Description=qemu-ui daemon (QEMU web UI)
Documentation=https://github.com/billsargent/qemu-ui
After=network-online.target qemu-ui-helper.service
Wants=network-online.target qemu-ui-helper.service

[Service]
Type=simple
User=@USER@
Group=@USER@
SupplementaryGroups=kvm
ExecStart=@DAEMON@ --data-dir @DATA_DIR@ --run-dir /run/qemu-ui --listen @LISTEN@@EXTRA_ARGS@
WorkingDirectory=@WORK_DIR@
@ENVIRONMENT@
# VMs are separate processes that must outlive the daemon (plan.md §3.2):
# `systemctl stop`/`restart` signals only the daemon; QEMU and its sidecars
# keep running and the next start reattaches to them.
KillMode=process
TimeoutStopSec=20
Restart=on-failure
RestartSec=2

# Short, private socket directory, kept across restarts so running VMs'
# monitor sockets stay reachable.
RuntimeDirectory=qemu-ui
RuntimeDirectoryMode=0700
RuntimeDirectoryPreserve=yes
UMask=0077

# Hardening that QEMU tolerates. QEMU runs inside this unit, so: no
# MemoryDenyWriteExecute (TCG generates code), no SystemCallFilter (QEMU
# applies its own -sandbox), no PrivateDevices (/dev/kvm, /dev/net/tun,
# /dev/vhost-net). ProtectSystem=full, not strict: pools and ISOs live in
# admin-chosen directories.
NoNewPrivileges=yes
ProtectSystem=full
PrivateTmp=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectClock=yes
ProtectHostname=yes
RestrictSUIDSGID=yes
RestrictRealtime=yes
LockPersonality=yes

[Install]
WantedBy=multi-user.target
