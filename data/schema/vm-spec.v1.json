{
  "$defs": {
    "CacheMode": {
      "oneOf": [
        {
          "enum": [
            "writeback",
            "writethrough",
            "directsync"
          ],
          "type": "string"
        },
        {
          "const": "none",
          "description": "O_DIRECT, flushes honoured. Best default for most guests.",
          "type": "string"
        },
        {
          "const": "unsafe",
          "description": "Ignores flushes: fast, loses data on host crash.",
          "type": "string"
        }
      ]
    },
    "CpuSpec": {
      "properties": {
        "count": {
          "description": "Total vCPUs.",
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "model": {
          "default": null,
          "description": "CPU model; `None` uses the machine default.",
          "type": [
            "string",
            "null"
          ]
        },
        "props": {
          "additionalProperties": {
            "type": "string"
          },
          "default": {},
          "description": "Extra CPU properties, e.g. `hv-passthrough=on`.",
          "type": "object"
        },
        "topology": {
          "anyOf": [
            {
              "$ref": "#/$defs/Topology"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "required": [
        "count"
      ],
      "type": "object"
    },
    "DeviceSpec": {
      "description": "A device added from the palette.",
      "properties": {
        "bus": {
          "default": null,
          "description": "Bus to attach to (a QEMU bus id, e.g. `qui-usb.0`); `None` lets QEMU\npick the machine's default bus for the device.",
          "type": [
            "string",
            "null"
          ]
        },
        "driver": {
          "description": "QEMU device type, e.g. `virtio-rng-pci`.",
          "type": "string"
        },
        "props": {
          "additionalProperties": true,
          "default": {},
          "description": "Properties the user set, typed as QEMU expects them (bool, number or\nstring). Unset properties keep QEMU's defaults.",
          "type": "object"
        }
      },
      "required": [
        "driver"
      ],
      "type": "object"
    },
    "DiskBus": {
      "oneOf": [
        {
          "const": "virtio",
          "description": "virtio-blk on PCI (or virtio-mmio machines).",
          "type": "string"
        },
        {
          "const": "scsi",
          "description": "virtio-scsi controller + scsi-hd / scsi-cd.",
          "type": "string"
        },
        {
          "const": "nvme",
          "description": "NVMe controller per disk.",
          "type": "string"
        },
        {
          "const": "ide",
          "description": "IDE / AHCI (q35 has AHCI built in).",
          "type": "string"
        },
        {
          "const": "usb",
          "description": "usb-storage on an xHCI controller.",
          "type": "string"
        }
      ]
    },
    "DiskSpec": {
      "properties": {
        "aio": {
          "default": null,
          "description": "`threads`, `native`, `io_uring`; `None` picks a platform default.",
          "type": [
            "string",
            "null"
          ]
        },
        "boot_index": {
          "default": null,
          "format": "uint32",
          "minimum": 0,
          "type": [
            "integer",
            "null"
          ]
        },
        "bus": {
          "$ref": "#/$defs/DiskBus"
        },
        "cache": {
          "$ref": "#/$defs/CacheMode",
          "default": "none"
        },
        "discard": {
          "default": true,
          "type": "boolean"
        },
        "image": {
          "$ref": "#/$defs/ImageRef"
        },
        "media": {
          "$ref": "#/$defs/Media",
          "default": "disk"
        },
        "readonly": {
          "default": false,
          "type": "boolean"
        },
        "slot": {
          "description": "Index used in this disk's QEMU ids (`qui-disk<N>`, `qui-dev<N>`).\nAbsent: the disk's position in `disks`. Hotplug pins it so a disk\nkeeps its ids when others are added or removed while the VM runs\n(and across restarts). Must be unique within a spec.",
          "format": "uint32",
          "minimum": 0,
          "type": [
            "integer",
            "null"
          ]
        }
      },
      "required": [
        "image",
        "bus"
      ],
      "type": "object"
    },
    "DisplaySpec": {
      "properties": {
        "device": {
          "default": null,
          "description": "Graphics device (`virtio-vga`, `VGA`, `virtio-gpu-pci`, …); `None` = headless.",
          "type": [
            "string",
            "null"
          ]
        },
        "spice": {
          "default": false,
          "description": "Also serve SPICE on loopback for a native client (remote-viewer):\nUSB redirection and smoother video than VNC (M5-05).",
          "type": "boolean"
        },
        "vdagent": {
          "default": false,
          "description": "qemu-vdagent: clipboard + absolute pointer (needs guest agent).",
          "type": "boolean"
        },
        "vnc": {
          "default": true,
          "description": "Serve the console over VNC (proxied; never exposed directly).",
          "type": "boolean"
        }
      },
      "type": "object"
    },
    "FirmwareSpec": {
      "oneOf": [
        {
          "description": "Whatever the machine boots by default (SeaBIOS on x86, built-in elsewhere).",
          "properties": {
            "kind": {
              "const": "default",
              "type": "string"
            }
          },
          "required": [
            "kind"
          ],
          "type": "object"
        },
        {
          "description": "Firmware from a descriptor, e.g. UEFI. The daemon keeps the per-VM\nNVRAM copy (as qcow2, so internal snapshots work).",
          "properties": {
            "id": {
              "type": "string"
            },
            "kind": {
              "const": "descriptor",
              "type": "string"
            }
          },
          "required": [
            "kind",
            "id"
          ],
          "type": "object"
        }
      ]
    },
    "ImageRef": {
      "properties": {
        "name": {
          "description": "File name inside the pool. No path separators.",
          "type": "string"
        },
        "pool": {
          "type": "string"
        }
      },
      "required": [
        "pool",
        "name"
      ],
      "type": "object"
    },
    "InputSpec": {
      "properties": {
        "usb_tablet": {
          "default": true,
          "description": "USB tablet for absolute pointing without guest agent.",
          "type": "boolean"
        }
      },
      "type": "object"
    },
    "IoLimits": {
      "properties": {
        "read_bytes_per_sec": {
          "default": null,
          "format": "uint64",
          "minimum": 0,
          "type": [
            "integer",
            "null"
          ]
        },
        "read_iops": {
          "default": null,
          "format": "uint64",
          "minimum": 0,
          "type": [
            "integer",
            "null"
          ]
        },
        "write_bytes_per_sec": {
          "default": null,
          "format": "uint64",
          "minimum": 0,
          "type": [
            "integer",
            "null"
          ]
        },
        "write_iops": {
          "default": null,
          "format": "uint64",
          "minimum": 0,
          "type": [
            "integer",
            "null"
          ]
        }
      },
      "type": "object"
    },
    "MachineSpec": {
      "properties": {
        "props": {
          "additionalProperties": {
            "type": "string"
          },
          "default": {},
          "description": "Extra `-machine` properties, e.g. `smm=on`.",
          "type": "object"
        },
        "type": {
          "type": "string"
        }
      },
      "required": [
        "type"
      ],
      "type": "object"
    },
    "Media": {
      "enum": [
        "disk",
        "cdrom"
      ],
      "type": "string"
    },
    "MemorySpec": {
      "properties": {
        "size_mib": {
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "size_mib"
      ],
      "type": "object"
    },
    "NicBackend": {
      "oneOf": [
        {
          "description": "This VM's own slirp NAT.",
          "properties": {
            "forwards": {
              "default": [],
              "items": {
                "$ref": "#/$defs/PortForward"
              },
              "type": "array"
            },
            "kind": {
              "const": "user",
              "type": "string"
            }
          },
          "required": [
            "kind"
          ],
          "type": "object"
        },
        {
          "description": "Attached to a network object by id (M3-01). Forwards apply only to\nnetwork kinds that take them (NAT).",
          "properties": {
            "forwards": {
              "default": [],
              "items": {
                "$ref": "#/$defs/PortForward"
              },
              "type": "array"
            },
            "kind": {
              "const": "network",
              "type": "string"
            },
            "network": {
              "type": "string"
            }
          },
          "required": [
            "kind",
            "network"
          ],
          "type": "object"
        }
      ]
    },
    "NicSpec": {
      "properties": {
        "backend": {
          "$ref": "#/$defs/NicBackend"
        },
        "mac": {
          "default": null,
          "description": "Locally administered MAC; assigned at creation when absent.",
          "type": [
            "string",
            "null"
          ]
        },
        "model": {
          "description": "Device model, e.g. `virtio-net-pci`, `e1000e`.",
          "type": "string"
        },
        "queues": {
          "description": "Queue pairs (multiqueue). Needs a virtio-net model and a tap-style\nbackend; absent means one.",
          "format": "uint16",
          "maximum": 65535,
          "minimum": 0,
          "type": [
            "integer",
            "null"
          ]
        },
        "virtio": {
          "anyOf": [
            {
              "$ref": "#/$defs/VirtioNetOptions"
            },
            {
              "type": "null"
            }
          ],
          "description": "virtio-net offload toggles; absent leaves QEMU's defaults."
        }
      },
      "required": [
        "backend",
        "model"
      ],
      "type": "object"
    },
    "PortForward": {
      "properties": {
        "guest_port": {
          "format": "uint16",
          "maximum": 65535,
          "minimum": 0,
          "type": "integer"
        },
        "host_addr": {
          "description": "Host address to bind; loopback unless deliberately widened.",
          "type": "string"
        },
        "host_port": {
          "format": "uint16",
          "maximum": 65535,
          "minimum": 0,
          "type": "integer"
        },
        "proto": {
          "description": "`tcp` or `udp`.",
          "type": "string"
        }
      },
      "required": [
        "proto",
        "host_addr",
        "host_port",
        "guest_port"
      ],
      "type": "object"
    },
    "ResourceLimits": {
      "properties": {
        "cpu_max_percent": {
          "default": null,
          "description": "CPU cap in percent of one host core (200 = two full cores).",
          "format": "uint32",
          "minimum": 0,
          "type": [
            "integer",
            "null"
          ]
        },
        "cpu_weight": {
          "default": null,
          "description": "Relative CPU share against other VMs, 1–10000 (cgroup `cpu.weight`;\n100 is the default share). Linux only.",
          "format": "uint32",
          "minimum": 0,
          "type": [
            "integer",
            "null"
          ]
        },
        "io": {
          "$ref": "#/$defs/IoLimits",
          "default": {
            "read_bytes_per_sec": null,
            "read_iops": null,
            "write_bytes_per_sec": null,
            "write_iops": null
          },
          "description": "Disk IO throttling shared by all of the VM's disks."
        },
        "memory_max_mib": {
          "default": null,
          "description": "Hard memory limit for the whole QEMU process in MiB: guest RAM plus\nQEMU's own overhead.",
          "format": "uint64",
          "minimum": 0,
          "type": [
            "integer",
            "null"
          ]
        }
      },
      "type": "object"
    },
    "ShareSpec": {
      "description": "A host folder shared into the guest (M2-13).\n\nLike images, shares never hold host paths: they name a registered\n*share root* and a folder relative to it, which the daemon canonicalises\nand confines to that root. The guest mounts the share by its tag:\n`mount -t 9p -o trans=virtio <tag> /mnt` or `mount -t virtiofs <tag> /mnt`.",
      "properties": {
        "path": {
          "default": "",
          "description": "Folder inside the root, `/`-separated; empty for the root itself.",
          "type": "string"
        },
        "readonly": {
          "default": false,
          "description": "The guest cannot write. Read-only shares always use 9p.",
          "type": "boolean"
        },
        "root": {
          "description": "Name of a registered share root.",
          "type": "string"
        },
        "tag": {
          "description": "Mount tag the guest uses (letters, digits, `-`, `_`; up to 31).",
          "type": "string"
        }
      },
      "required": [
        "root",
        "tag"
      ],
      "type": "object"
    },
    "Topology": {
      "properties": {
        "cores": {
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "sockets": {
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "threads": {
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "sockets",
        "cores",
        "threads"
      ],
      "type": "object"
    },
    "UsbPassthrough": {
      "description": "A host USB device to pass through, matched the way QEMU's `usb-host`\nmatches: by vendor and product, optionally narrowed to a bus and port so\ntwo identical devices can be told apart. The guest sees the device\nwhenever it is plugged in; QEMU waits for it otherwise.",
      "properties": {
        "host_bus": {
          "default": null,
          "description": "Linux bus number (`hostbus`); not available on Windows hosts.",
          "format": "uint32",
          "minimum": 0,
          "type": [
            "integer",
            "null"
          ]
        },
        "host_port": {
          "default": null,
          "description": "Linux port path such as `1.2` (`hostport`); stable per physical port.",
          "type": [
            "string",
            "null"
          ]
        },
        "label": {
          "default": null,
          "description": "Display name remembered from the host (e.g. \"Logitech USB Receiver\").",
          "type": [
            "string",
            "null"
          ]
        },
        "product_id": {
          "description": "4 hex digits, e.g. `c52b`.",
          "type": "string"
        },
        "vendor_id": {
          "description": "4 hex digits, e.g. `046d`.",
          "type": "string"
        }
      },
      "required": [
        "vendor_id",
        "product_id"
      ],
      "type": "object"
    },
    "VirtioNetOptions": {
      "description": "virtio-net feature toggles (M3-07). Each `None` keeps QEMU's default (on).",
      "properties": {
        "csum": {
          "description": "Checksum offload, host and guest (`csum`, `guest_csum`).",
          "type": [
            "boolean",
            "null"
          ]
        },
        "mrg_rxbuf": {
          "description": "Mergeable receive buffers (`mrg_rxbuf`).",
          "type": [
            "boolean",
            "null"
          ]
        },
        "tso": {
          "description": "TCP segmentation offload, IPv4 and IPv6 (`host_tso*`, `guest_tso*`).\nNeeds checksum offload.",
          "type": [
            "boolean",
            "null"
          ]
        }
      },
      "type": "object"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
    "accel": {
      "default": "auto",
      "description": "`auto`, or an accelerator name (`kvm`, `whpx`, `hvf`, `tcg`).",
      "type": "string"
    },
    "arch": {
      "description": "Target architecture in QEMU naming.",
      "type": "string"
    },
    "cpu": {
      "$ref": "#/$defs/CpuSpec"
    },
    "devices": {
      "default": [],
      "description": "Devices added from the palette (M4-05); ids `qui-xdev<N>`.",
      "items": {
        "$ref": "#/$defs/DeviceSpec"
      },
      "type": "array"
    },
    "disks": {
      "default": [],
      "items": {
        "$ref": "#/$defs/DiskSpec"
      },
      "type": "array"
    },
    "display": {
      "$ref": "#/$defs/DisplaySpec",
      "default": {
        "device": null,
        "spice": false,
        "vdagent": false,
        "vnc": true
      }
    },
    "firmware": {
      "$ref": "#/$defs/FirmwareSpec",
      "default": {
        "kind": "default"
      }
    },
    "input": {
      "$ref": "#/$defs/InputSpec",
      "default": {
        "usb_tablet": true
      }
    },
    "limits": {
      "$ref": "#/$defs/ResourceLimits",
      "default": {
        "cpu_max_percent": null,
        "cpu_weight": null,
        "io": {
          "read_bytes_per_sec": null,
          "read_iops": null,
          "write_bytes_per_sec": null,
          "write_iops": null
        },
        "memory_max_mib": null
      },
      "description": "CPU, memory and disk IO limits (M6-07)."
    },
    "machine": {
      "$ref": "#/$defs/MachineSpec",
      "description": "Versioned machine type; aliases are pinned at creation (§5.2)."
    },
    "memory": {
      "$ref": "#/$defs/MemorySpec"
    },
    "name": {
      "description": "`[A-Za-z0-9][A-Za-z0-9._-]{0,62}`; also used in `-name`.",
      "type": "string"
    },
    "nics": {
      "default": [],
      "items": {
        "$ref": "#/$defs/NicSpec"
      },
      "type": "array"
    },
    "passthrough": {
      "default": [],
      "description": "Raw argv tokens appended after generated options (§5.3).",
      "items": {
        "type": "string"
      },
      "type": "array"
    },
    "shares": {
      "default": [],
      "description": "Host folders shared into the guest (Linux hosts; plan.md §9.6).",
      "items": {
        "$ref": "#/$defs/ShareSpec"
      },
      "type": "array"
    },
    "spec_version": {
      "format": "uint32",
      "minimum": 0,
      "type": "integer"
    },
    "usb": {
      "default": [],
      "description": "Host USB devices passed through to the guest (M2-12).",
      "items": {
        "$ref": "#/$defs/UsbPassthrough"
      },
      "type": "array"
    }
  },
  "required": [
    "spec_version",
    "name",
    "arch",
    "machine",
    "cpu",
    "memory"
  ],
  "title": "VmSpec",
  "type": "object"
}
