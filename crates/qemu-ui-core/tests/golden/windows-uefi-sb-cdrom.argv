/usr/bin/qemu-system-x86_64
-name
guest=debian
-msg
timestamp=on
-nodefaults
-no-user-config
-accel
kvm
-machine
pc-q35-11.1,pflash0=qui-fw-code,pflash1=qui-fw-vars,smm=on
-global
driver=cfi.pflash01,property=secure,value=on
-cpu
max
-smp
4,sockets=1,cores=2,threads=2
-m
4096M
-blockdev
{"driver":"file","filename":"C:\\qemu\\share\\edk2-x86_64-secure-code.fd","node-name":"qui-fw-code-file","read-only":true}
-blockdev
{"driver":"raw","file":"qui-fw-code-file","node-name":"qui-fw-code","read-only":true}
-blockdev
{"driver":"file","filename":"C:\\qui\\vms\\vm1\\VARS.qcow2","node-name":"qui-fw-vars-file"}
-blockdev
{"driver":"qcow2","file":"qui-fw-vars-file","node-name":"qui-fw-vars"}
-device
{"driver":"qemu-xhci","id":"qui-usb"}
-blockdev
{"aio":"threads","cache":{"direct":false,"no-flush":false},"discard":"unmap","driver":"file","filename":"/var/lib/qemu-ui/pools/default/debian.qcow2","node-name":"qui-disk0-file","read-only":false}
-blockdev
{"cache":{"direct":false,"no-flush":false},"discard":"unmap","driver":"qcow2","file":"qui-disk0-file","node-name":"qui-disk0","read-only":false}
-device
{"bootindex":1,"drive":"qui-disk0","driver":"virtio-blk-pci","id":"qui-dev0","write-cache":"on"}
-blockdev
{"aio":"threads","cache":{"direct":false,"no-flush":false},"driver":"file","filename":"/var/lib/qemu-ui/pools/default/install, disc 1.iso","node-name":"qui-disk1-file","read-only":true}
-blockdev
{"cache":{"direct":false,"no-flush":false},"driver":"raw","file":"qui-disk1-file","node-name":"qui-disk1","read-only":true}
-device
{"bootindex":0,"drive":"qui-disk1","driver":"ide-cd","id":"qui-dev1"}
-netdev
{"hostfwd":[{"str":"tcp:127.0.0.1:2222-:22"}],"id":"qui-net0","type":"user"}
-device
{"driver":"virtio-net-pci","id":"qui-nic0","mac":"52:54:00:12:34:56","netdev":"qui-net0"}
-device
{"driver":"virtio-vga","id":"qui-gpu0"}
-device
{"bus":"qui-usb.0","driver":"usb-tablet","id":"qui-tablet"}
-device
{"driver":"virtio-serial-pci","id":"qui-vser0"}
-chardev
qemu-vdagent,id=qui-vdagent,name=vdagent,clipboard=on,mouse=on
-device
{"bus":"qui-vser0.0","chardev":"qui-vdagent","driver":"virtserialport","name":"com.redhat.spice.0"}
-display
none
-vnc
127.0.0.1:7,password=on
-chardev
socket,id=qui-qmp,path=C:\qui\r\vm1\qmp.sock,server=on,wait=off
-object
monitor-qmp,id=qui-qmp-mon,chardev=qui-qmp
-chardev
socket,id=qui-qmp-user,path=C:\qui\r\vm1\qmp-user.sock,server=on,wait=off
-object
monitor-qmp,id=qui-qmp-user-mon,chardev=qui-qmp-user
-chardev
socket,id=qui-ser0,path=C:\qui\r\vm1\serial.sock,server=on,wait=off,logfile=C:\qui\vms\vm1\serial.log,logappend=on
-serial
chardev:qui-ser0
-pidfile
C:\qui\r\vm1\qemu.pid
-S
-global
ICH9-LPC.disable_s3=1
