/usr/bin/qemu-system-x86_64
-name
guest=debian,debug-threads=on
-msg
timestamp=on
-nodefaults
-no-user-config
-accel
kvm
-machine
pc-q35-11.1
-cpu
host
-smp
4
-m
4096M
-device
{"driver":"qemu-xhci","id":"qui-usb"}
-blockdev
{"aio":"threads","cache":{"direct":true,"no-flush":false},"discard":"unmap","driver":"file","filename":"/var/lib/qemu-ui/pools/default/debian.qcow2","node-name":"qui-disk0-file","read-only":false}
-blockdev
{"cache":{"direct":true,"no-flush":false},"discard":"unmap","driver":"qcow2","file":"qui-disk0-file","node-name":"qui-disk0","read-only":false}
-device
{"bootindex":1,"drive":"qui-disk0","driver":"virtio-blk-pci","id":"qui-dev0","write-cache":"on"}
-netdev
{"hostfwd":[{"str":"tcp:127.0.0.1:2222-:22"}],"id":"qui-net0","type":"user"}
-device
{"driver":"virtio-net-pci","id":"qui-nic0","mac":"52:54:00:12:34:56","netdev":"qui-net0"}
-device
{"driver":"virtio-vga","id":"qui-gpu0"}
-device
{"bus":"qui-usb.0","driver":"usb-tablet","id":"qui-tablet"}
-fsdev
local,id=qui-fs0,path=/srv/src/projects/web,, v2,security_model=mapped-xattr
-device
{"driver":"virtio-9p-pci","fsdev":"qui-fs0","id":"qui-share0","mount_tag":"src"}
-fsdev
local,id=qui-fs1,path=/srv/docs,security_model=mapped-xattr,readonly=on
-device
{"driver":"virtio-9p-pci","fsdev":"qui-fs1","id":"qui-share1","mount_tag":"docs"}
-display
none
-vnc
unix:/run/qui/vm1/vnc.sock
-chardev
socket,id=qui-qmp,path=/run/qui/vm1/qmp.sock,server=on,wait=off
-object
monitor-qmp,id=qui-qmp-mon,chardev=qui-qmp
-chardev
socket,id=qui-qmp-user,path=/run/qui/vm1/qmp-user.sock,server=on,wait=off
-object
monitor-qmp,id=qui-qmp-user-mon,chardev=qui-qmp-user
-chardev
socket,id=qui-ser0,path=/run/qui/vm1/serial.sock,server=on,wait=off,logfile=/var/lib/qemu-ui/vms/vm1/serial.log,logappend=on
-serial
chardev:qui-ser0
-pidfile
/run/qui/vm1/qemu.pid
-S
